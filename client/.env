# Để trống để dùng Vite Dev Proxy (/api -> VITE_API_TARGET) hoặc cùng nguồn trên IIS Express.
# Nếu chạy Frontend tách biệt không qua proxy, đặt ví dụ: VITE_API_BASE_URL=https://localhost:44329
VITE_API_BASE_URL=

# Địa chỉ Backend ASP.NET Web API (IIS Express trong QuanLyBanHang.csproj) dùng cho Vite Proxy lúc dev
VITE_API_TARGET=https://localhost:44329
