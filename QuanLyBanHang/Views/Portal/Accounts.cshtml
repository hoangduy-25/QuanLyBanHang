@{ Layout = "~/Views/Shared/_PortalLayout.cshtml"; ViewBag.Title = "Quản lý tài khoản"; }
<div class="hc-card p-3 mb-3 d-flex flex-wrap justify-content-between gap-2">
    <div class="d-flex gap-1" id="pa-tabs">
        <button class="hc-cat-pill active" onclick="loadPa('', this)">Tất cả</button>
        <button class="hc-cat-pill" onclick="loadPa('KhachHang', this)">Khách hàng</button>
        <button class="hc-cat-pill" onclick="loadPa('NhanVien', this)">Nhân viên</button>
        <button class="hc-cat-pill" onclick="loadPa('QuanLy', this)">Quản lý</button>
    </div>
    <input id="pa-kw" class="form-control form-control-sm hc-pill bg-light border-0 px-3" style="max-width:260px" placeholder="Tìm tên, email, SĐT..." onchange="loadPa(curRole)" />
</div>
<div id="pa-box" class="hc-card p-3 table-responsive">Đang tải...</div>
@section scripts {
<script>
let curRole = "";
async function loadPa(role, btn) {
    curRole = role;
    if (btn) { document.querySelectorAll("#pa-tabs .hc-cat-pill").forEach(b => b.classList.remove("active")); btn.classList.add("active"); }
    let url = "/api/tai-khoan/tim-kiem?Page=1&PageSize=50";
    if (role) url += "&VaiTro=" + role;
    const kw = document.getElementById("pa-kw").value.trim();
    if (kw) url += "&TuKhoa=" + encodeURIComponent(kw);
    const res = await HCShopApi.request(url);
    document.getElementById("pa-box").innerHTML = `<table class="table table-sm align-middle mb-0"><thead><tr><th>Thành viên</th><th>Liên hệ</th><th>Ngày tạo</th><th>Vai trò</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>` +
        res.data.items.map(t => `<tr>
            <td><strong>${t.hoTen}</strong></td>
            <td class="small">${t.email}<br/>${t.soDienThoai}</td>
            <td class="small">${new Date(t.ngayTao).toLocaleDateString("vi-VN")}</td>
            <td><span class="badge hc-badge-neutral">${t.vaiTro}</span></td>
            <td>${HCShopApi.statusBadge(t.trangThai)} ${t.lyDoKhoa ? `<div class="small text-danger">${t.lyDoKhoa}</div>` : ""}</td>
            <td>${t.vaiTro === "KhachHang" ? (t.trangThai === "HoatDong"
                ? `<button class="btn btn-outline-danger btn-sm hc-pill" onclick="lockAcc('${t.id}')">Khóa</button>`
                : `<button class="btn btn-outline-success btn-sm hc-pill" onclick="unlockAcc('${t.id}')">Mở khóa</button>`) : "<span class='text-muted small'>—</span>"}</td>
        </tr>`).join("") + `</tbody></table>`;
}
async function lockAcc(id) {
    const lyDo = prompt("Nhập lý do khóa tài khoản:"); if (!lyDo) return;
    const res = await HCShopApi.request("/api/tai-khoan/" + id + "/khoa", { method: "PATCH", body: JSON.stringify({ lyDo }) });
    if (res.data && res.data.canhBao) alert(res.data.canhBao);
    loadPa(curRole);
}
async function unlockAcc(id) {
    await HCShopApi.request("/api/tai-khoan/" + id + "/mo-khoa", { method: "PATCH" });
    loadPa(curRole);
}
document.addEventListener("DOMContentLoaded", () => loadPa(""));
</script>
}
