@{ Layout = "~/Views/Shared/_PortalLayout.cshtml"; ViewBag.Title = "Quản lý mã giảm giá"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h5 class="fw-bold mb-0">Quản lý mã giảm giá</h5>
    <button class="btn hc-btn-primary btn-sm px-3" onclick="createVoucher()">+ Tạo mã giảm giá</button>
</div>
<div id="pv-grid" class="row g-3"></div>
@section scripts {
<script>
async function loadPv() {
    const res = await HCShopApi.request("/api/ma-giam-gia");
    document.getElementById("pv-grid").innerHTML = res.data.map(v => `
        <div class="col-md-6"><div class="hc-card p-4">
            <div class="d-flex justify-content-between mb-1"><strong class="fs-5 text-primary">${v.ma}</strong>${v.hienThi ? '<span class="badge hc-badge-success">Đang bật</span>' : '<span class="badge hc-badge-neutral">Ngừng áp dụng</span>'}</div>
            <div class="small text-muted mb-2">${v.moTa || ""} • Đã dùng: ${v.soLuotDaDung}/${v.soLuotToiDa}</div>
            <button class="btn btn-light border text-danger btn-sm hc-pill" onclick="delPv('${v.id}')">Xóa / Ngừng áp dụng</button>
        </div></div>`).join("");
}
async function delPv(id) { if (!confirm("Xóa mã này?")) return; const res = await HCShopApi.request("/api/ma-giam-gia/" + id, { method: "DELETE" }); alert(res.message); loadPv(); }
async function createVoucher() {
    const ma = prompt("Mã code:"); if (!ma) return;
    const now = new Date(); const end = new Date(now.getTime() + 30 * 86400000);
    await HCShopApi.request("/api/ma-giam-gia", { method: "POST", body: JSON.stringify({ ma, moTa: prompt("Mô tả:"), loai: "PhanTram", giaTri: parseFloat(prompt("% giảm (1-100):") || "10"), donToiThieu: 0, ngayBatDau: now.toISOString(), ngayKetThuc: end.toISOString(), soLuotToiDa: 100, hienThi: true }) });
    loadPv();
}
document.addEventListener("DOMContentLoaded", loadPv);
</script>
}
