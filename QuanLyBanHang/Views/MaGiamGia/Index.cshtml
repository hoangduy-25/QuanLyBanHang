@{ ViewBag.Title = "Kho mã giảm giá"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Kho mã giảm giá</h4>
    <a href="@Url.Action("ThanhToan", "GioHang")" class="btn hc-btn-primary btn-sm px-3">Thanh toán &rarr;</a>
</div>
<div class="hc-card p-3 mb-3 d-flex flex-wrap gap-2 align-items-center">
    <input id="vw-search" class="form-control form-control-sm hc-pill bg-light border-0 px-3" style="max-width:280px" placeholder="Tìm mã code hoặc mô tả..." oninput="loadVouchers()" />
    <span id="vw-count" class="badge rounded-pill hc-badge-success px-3 py-2">Đang khả dụng</span>
</div>
<div id="vw-grid" class="row g-3"></div>
@section scripts {
<script>
async function loadVouchers() {
    const kw = document.getElementById("vw-search").value.trim();
    const url = kw ? "/api/ma-giam-gia/tim-kiem?tuKhoa=" + encodeURIComponent(kw) : "/api/ma-giam-gia";
    const res = await HCShopApi.request(url);
    const items = res.data || [];
    document.getElementById("vw-count").textContent = "Đang khả dụng (" + items.length + ")";
    const box = document.getElementById("vw-grid");
    if (!items.length) { box.innerHTML = `<div class="col-12"><div class="hc-card p-5 text-center text-muted">Hiện chưa có mã giảm giá.</div></div>`; return; }
    box.innerHTML = items.map(v => {
        const pct = Math.round((v.soLuotDaDung / Math.max(1, v.soLuotToiDa)) * 100);
        return `<div class="col-md-6"><div class="hc-card p-4 h-100">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-bold fs-5 text-primary">${v.ma}</span>
                <span class="badge rounded-pill hc-badge-success">Đang khả dụng</span>
            </div>
            <p class="small text-muted mb-2">${v.moTa || ""}</p>
            <div class="small mb-2">Đơn tối thiểu: <strong>${HCShopApi.formatVnd(v.donToiThieu)}</strong> • Còn lại: <strong>${v.soLuotConLai}/${v.soLuotToiDa}</strong></div>
            <div class="progress mb-3" style="height:6px"><div class="progress-bar bg-dark" style="width:${pct}%"></div></div>
            <div class="d-flex justify-content-between align-items-center">
                <small class="text-muted">HSD: ${new Date(v.ngayKetThuc).toLocaleDateString("vi-VN")}</small>
                <button class="btn btn-light border btn-sm hc-pill px-3" onclick="navigator.clipboard.writeText('${v.ma}');alert('Đã sao chép mã ${v.ma}')">Sao chép</button>
            </div>
        </div></div>`;
    }).join("");
}
document.addEventListener("DOMContentLoaded", loadVouchers);
</script>
}
