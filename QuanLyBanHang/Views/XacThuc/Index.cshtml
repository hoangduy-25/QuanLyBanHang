@{ ViewBag.Title = "Đăng nhập / Đăng ký"; }
<div class="row justify-content-center">
    <div class="col-md-6">
        <div class="hc-card p-4">
            <div class="d-flex gap-2 mb-4" id="auth-tabs">
                <button class="hc-cat-pill active" onclick="showAuthTab('login', this)">Đăng nhập</button>
                <button class="hc-cat-pill" onclick="showAuthTab('register', this)">Đăng ký</button>
                <button class="hc-cat-pill" onclick="showAuthTab('forgot', this)">Quên mật khẩu</button>
            </div>
            <div id="auth-alert" class="alert d-none"></div>

            <form id="tab-login" onsubmit="doLogin(event)">
                <div class="mb-3"><label class="form-label small fw-semibold">Email hoặc SĐT *</label><input id="lTk" class="form-control hc-pill" required /></div>
                <div class="mb-3"><label class="form-label small fw-semibold">Mật khẩu *</label><input id="lMk" type="password" class="form-control hc-pill" required /></div>
                <button type="submit" class="btn hc-btn-primary w-100 py-2">Đăng nhập vào HCShop</button>
            </form>

            <form id="tab-register" class="d-none" onsubmit="doRegister(event)">
                <div class="mb-2"><label class="form-label small fw-semibold">Họ và tên *</label><input id="rHoTen" class="form-control hc-pill" required /></div>
                <div class="row">
                    <div class="col-md-6 mb-2"><label class="form-label small fw-semibold">SĐT *</label><input id="rSdt" class="form-control hc-pill" required /></div>
                    <div class="col-md-6 mb-2"><label class="form-label small fw-semibold">Email *</label><input id="rEmail" type="email" class="form-control hc-pill" required /></div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-2"><label class="form-label small fw-semibold">Mật khẩu *</label><input id="rMk" type="password" class="form-control hc-pill" required /></div>
                    <div class="col-md-6 mb-2"><label class="form-label small fw-semibold">Xác nhận mật khẩu *</label><input id="rCf" type="password" class="form-control hc-pill" required /></div>
                </div>
                <div class="mb-2"><label class="form-label small fw-semibold">Câu hỏi bảo mật *</label>
                    <select id="rQ" class="form-select hc-pill"><option>Tên thú cưng đầu tiên của bạn là gì?</option><option>Trường tiểu học của bạn tên là gì?</option><option>Thành phố nơi bạn sinh ra là gì?</option></select>
                </div>
                <div class="mb-3"><label class="form-label small fw-semibold">Câu trả lời bảo mật *</label><input id="rA" class="form-control hc-pill" required /></div>
                <button type="submit" class="btn hc-btn-primary w-100 py-2">Tạo tài khoản mới</button>
            </form>

            <div id="tab-forgot" class="d-none">
                <div class="mb-2"><label class="form-label small fw-semibold">Email hoặc SĐT *</label><input id="fTk" class="form-control hc-pill" /></div>
                <button class="btn btn-light border btn-sm hc-pill mb-3" type="button" onclick="getQ()">Lấy câu hỏi bảo mật</button>
                <div id="fStep2" class="d-none">
                    <div id="fQText" class="fw-semibold small mb-2"></div>
                    <div class="mb-2"><input id="fAns" class="form-control hc-pill" placeholder="Câu trả lời bảo mật" /></div>
                    <div class="mb-2"><input id="fNew" type="password" class="form-control hc-pill" placeholder="Mật khẩu mới" /></div>
                    <div class="mb-3"><input id="fCf" type="password" class="form-control hc-pill" placeholder="Xác nhận mật khẩu mới" /></div>
                    <button class="btn hc-btn-primary w-100 py-2" type="button" onclick="doReset()">Đặt lại mật khẩu</button>
                </div>
            </div>
        </div>
    </div>
</div>
@section scripts {
<script>
function showAuthTab(name, btn) {
    ["login", "register", "forgot"].forEach(t => document.getElementById("tab-" + t).classList.toggle("d-none", t !== name));
    document.querySelectorAll("#auth-tabs .hc-cat-pill").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
    document.getElementById("auth-alert").classList.add("d-none");
}
async function doLogin(e) {
    e.preventDefault();
    const box = document.getElementById("auth-alert");
    try {
        const res = await HCShopApi.request("/api/xac-thuc/dang-nhap", { method: "POST", ignoreAuthRedirect: true, body: JSON.stringify({ taiKhoan: lTk.value, matKhau: lMk.value }) });
        HCShopApi.setAuth(res.data);
        window.location.href = (res.data.vaiTro === "QuanLy" || res.data.vaiTro === "NhanVien") ? "/QuanTri" : "/";
    } catch (err) { box.className = "alert alert-danger"; box.textContent = err.message; }
}
async function doRegister(e) {
    e.preventDefault();
    const box = document.getElementById("auth-alert");
    try {
        await HCShopApi.request("/api/xac-thuc/dang-ky", { method: "POST", ignoreAuthRedirect: true, body: JSON.stringify({ hoTen: rHoTen.value, soDienThoai: rSdt.value, email: rEmail.value, matKhau: rMk.value, xacNhanMatKhau: rCf.value, cauHoiBaoMat: rQ.value, cauTraLoiBaoMat: rA.value }) });
        box.className = "alert alert-success"; box.textContent = "Đăng ký thành công! Bạn có thể đăng nhập ngay.";
    } catch (err) { box.className = "alert alert-danger"; box.textContent = err.message; }
}
async function getQ() {
    const box = document.getElementById("auth-alert");
    try {
        const res = await HCShopApi.request("/api/xac-thuc/cau-hoi-bao-mat?taiKhoan=" + encodeURIComponent(fTk.value), { ignoreAuthRedirect: true });
        fQText.textContent = "Câu hỏi: " + res.data.cauHoiBaoMat;
        fStep2.classList.remove("d-none");
    } catch (err) { box.className = "alert alert-danger"; box.textContent = err.message; }
}
async function doReset() {
    const box = document.getElementById("auth-alert");
    try {
        await HCShopApi.request("/api/xac-thuc/quen-mat-khau", { method: "POST", ignoreAuthRedirect: true, body: JSON.stringify({ taiKhoan: fTk.value, cauTraLoiBaoMat: fAns.value, matKhauMoi: fNew.value, xacNhanMatKhauMoi: fCf.value }) });
        box.className = "alert alert-success"; box.textContent = "Đặt lại mật khẩu thành công!";
    } catch (err) { box.className = "alert alert-danger"; box.textContent = err.message; }
}
</script>
}
