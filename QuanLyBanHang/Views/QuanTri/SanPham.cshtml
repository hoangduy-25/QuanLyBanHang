@{ Layout = "~/Views/Shared/_PortalLayout.cshtml"; ViewBag.Title = "Sản phẩm & Danh mục"; }
<div class="hc-card p-3 mb-3 d-flex justify-content-between align-items-center flex-wrap gap-2">
    <div class="d-flex gap-1">
        <button class="hc-cat-pill active" onclick="catTab('sp', this)">Sản phẩm</button>
        <button class="hc-cat-pill" onclick="catTab('dm', this)">Danh mục</button>
    </div>
    <button class="btn hc-btn-primary btn-sm px-3" onclick="openAddModal()">+ Thêm mới</button>
</div>
<div id="cat-box" class="hc-card p-3 table-responsive">Đang tải...</div>

<!-- Modal Thêm / Sửa Sản phẩm có Upload & Preview ảnh -->
<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold" id="spModalTitle">Thêm sản phẩm mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="spModalErr" class="alert alert-danger d-none"></div>
                <input type="hidden" id="spId" />
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Danh mục *</label>
                        <select id="spDanhMuc" class="form-select"></select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-semibold">Mã sản phẩm (SKU) *</label>
                        <input id="spMa" class="form-control" placeholder="VD: SP-001" />
                    </div>
                    <div class="col-md-8">
                        <label class="form-label small fw-semibold">Tên sản phẩm *</label>
                        <input id="spTen" class="form-control" />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-semibold">Giá bán (VNĐ) *</label>
                        <input id="spGia" type="number" min="1" class="form-control" />
                    </div>
                    <div class="col-md-6 sp-create-only">
                        <label class="form-label small fw-semibold">Số lượng tồn ban đầu *</label>
                        <input id="spTon" type="number" min="0" value="10" class="form-control" />
                    </div>
                    <div class="col-md-6 sp-create-only">
                        <label class="form-label small fw-semibold">Ngưỡng tồn tối thiểu</label>
                        <input id="spNguong" type="number" min="0" value="5" class="form-control" />
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Hình ảnh sản phẩm (.jpg, .png, .webp, tối đa 5MB)</label>
                        <div class="d-flex flex-wrap align-items-center gap-3">
                            <img id="spImgPreview" src="" alt="Preview" class="rounded-3 border bg-light d-none" style="width:90px;height:90px;object-fit:cover" />
                            <div class="flex-grow-1">
                                <input id="spFile" type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm mb-2" onchange="handleUploadFile(this, 'products', 'spHinhAnh', 'spImgPreview')" />
                                <input id="spHinhAnh" class="form-control form-control-sm" placeholder="Hoặc dán URL ảnh (/images/products/...)" oninput="syncPreview(this.value, 'spImgPreview')" />
                            </div>
                        </div>
                    </div>
                    <div class="col-12">
                        <label class="form-label small fw-semibold">Mô tả</label>
                        <textarea id="spMoTa" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border hc-pill" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn hc-btn-primary px-4" onclick="saveProduct()">Lưu sản phẩm</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Thêm Danh mục có Upload ảnh -->
<div class="modal fade" id="categoryModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content rounded-4">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">Thêm danh mục mới</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div id="dmModalErr" class="alert alert-danger d-none"></div>
                <div class="mb-2"><label class="form-label small fw-semibold">Tên danh mục *</label><input id="dmTen" class="form-control" /></div>
                <div class="mb-2"><label class="form-label small fw-semibold">Mô tả</label><textarea id="dmMoTa" class="form-control" rows="2"></textarea></div>
                <div class="mb-2">
                    <label class="form-label small fw-semibold">Hình ảnh danh mục</label>
                    <img id="dmImgPreview" src="" alt="Preview" class="rounded-3 border bg-light d-none mb-2" style="width:80px;height:80px;object-fit:cover" />
                    <input type="file" accept=".jpg,.jpeg,.png,.webp" class="form-control form-control-sm mb-1" onchange="handleUploadFile(this, 'categories', 'dmHinhAnh', 'dmImgPreview')" />
                    <input id="dmHinhAnh" class="form-control form-control-sm" placeholder="/images/categories/..." oninput="syncPreview(this.value, 'dmImgPreview')" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light border hc-pill" data-bs-dismiss="modal">Hủy</button>
                <button type="button" class="btn hc-btn-primary px-4" onclick="saveCategory()">Lưu danh mục</button>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script>
let curTab = "sp";
let cachedProducts = [];
let cachedCategories = [];

function syncPreview(url, imgId) {
    const img = document.getElementById(imgId);
    if (url && url.trim()) { img.src = url.trim(); img.classList.remove("d-none"); }
    else { img.src = ""; img.classList.add("d-none"); }
}

async function handleUploadFile(input, folder, targetInputId, previewId) {
    if (!input.files || !input.files[0]) return;
    try {
        const url = await HCShopApi.uploadImage(input.files[0], folder);
        document.getElementById(targetInputId).value = url;
        syncPreview(url, previewId);
    } catch (e) {
        alert(e.message);
        input.value = "";
    }
}

async function catTab(t, btn) {
    curTab = t;
    if (btn) { btn.parentElement.querySelectorAll(".hc-cat-pill").forEach(b => b.classList.remove("active")); btn.classList.add("active"); }
    const box = document.getElementById("cat-box");
    const dmRes = await HCShopApi.request("/api/danh-muc");
    cachedCategories = dmRes.data || [];

    if (t === "sp") {
        const res = await HCShopApi.request("/api/san-pham?Page=1&PageSize=50");
        cachedProducts = res.data.items || [];
        box.innerHTML = `<table class="table table-sm align-middle mb-0"><thead><tr><th>Ảnh</th><th>Sản phẩm</th><th>Danh mục</th><th>Giá bán</th><th>Tồn kho</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>` +
            cachedProducts.map(s => `<tr>
                <td>${s.hinhAnh ? `<img src="${s.hinhAnh}" style="width:44px;height:44px;object-fit:cover" class="rounded-2 border"/>` : `<span class="text-muted small">—</span>`}</td>
                <td><strong>${s.ten}</strong><div class="small text-muted">${s.maSanPham}</div></td>
                <td>${s.tenDanhMuc}</td>
                <td>${HCShopApi.formatVnd(s.giaBan)}</td>
                <td>${s.soLuongTon}</td>
                <td>${s.hienThi ? '<span class="badge hc-badge-success">Đang bán</span>' : '<span class="badge hc-badge-neutral">Đang ẩn</span>'}</td>
                <td class="d-flex gap-1">
                    <button class="btn btn-light border btn-sm hc-pill" onclick="openEditProduct('${s.id}')">Sửa</button>
                    <button class="btn btn-light border btn-sm hc-pill" onclick="toggleSp('${s.id}', ${!s.hienThi})">${s.hienThi ? "Ẩn" : "Hiện"}</button>
                    <button class="btn btn-light border text-danger btn-sm hc-pill" onclick="delSp('${s.id}')">Xóa</button>
                </td>
            </tr>`).join("") + `</tbody></table>`;
    } else {
        box.innerHTML = `<table class="table table-sm align-middle mb-0"><thead><tr><th>Ảnh</th><th>Danh mục</th><th>Số SP</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>` +
            cachedCategories.map(d => `<tr>
                <td>${d.hinhAnh ? `<img src="${d.hinhAnh}" style="width:44px;height:44px;object-fit:cover" class="rounded-2 border"/>` : `<span class="text-muted small">—</span>`}</td>
                <td><strong>${d.ten}</strong></td>
                <td>${d.soSanPham}</td>
                <td>${d.hienThi ? '<span class="badge hc-badge-success">Hiển thị</span>' : '<span class="badge hc-badge-neutral">Đang ẩn</span>'}</td>
                <td class="d-flex gap-1"><button class="btn btn-light border btn-sm hc-pill" onclick="toggleDm('${d.id}', ${!d.hienThi})">${d.hienThi ? "Ẩn" : "Hiện"}</button><button class="btn btn-light border text-danger btn-sm hc-pill" onclick="delDm('${d.id}')">Xóa</button></td>
            </tr>`).join("") + `</tbody></table>`;
    }
}

function populateCategorySelect(selectedId) {
    document.getElementById("spDanhMuc").innerHTML = cachedCategories.map(d =>
        `<option value="${d.id}" ${d.id === selectedId ? "selected" : ""}>${d.ten}</option>`).join("");
}

function openAddModal() {
    if (curTab === "dm") {
        dmTen.value = ""; dmMoTa.value = ""; dmHinhAnh.value = ""; syncPreview("", "dmImgPreview");
        dmModalErr.classList.add("d-none");
        new bootstrap.Modal(document.getElementById("categoryModal")).show();
    } else {
        if (!cachedCategories.length) { alert("Cần tạo ít nhất 1 danh mục trước."); return; }
        spId.value = ""; spModalTitle.textContent = "Thêm sản phẩm mới";
        populateCategorySelect(cachedCategories[0].id);
        spMa.value = ""; spTen.value = ""; spGia.value = ""; spTon.value = 10; spNguong.value = 5;
        spHinhAnh.value = ""; spMoTa.value = ""; spFile.value = ""; syncPreview("", "spImgPreview");
        document.querySelectorAll(".sp-create-only").forEach(e => e.classList.remove("d-none"));
        spModalErr.classList.add("d-none");
        new bootstrap.Modal(document.getElementById("productModal")).show();
    }
}

async function openEditProduct(id) {
    const res = await HCShopApi.request("/api/san-pham/" + id);
    const s = res.data;
    spId.value = s.id; spModalTitle.textContent = "Sửa thông tin sản phẩm";
    populateCategorySelect(s.danhMucId);
    spMa.value = s.maSanPham; spTen.value = s.ten; spGia.value = s.giaBan;
    spHinhAnh.value = s.hinhAnh || ""; spMoTa.value = s.moTa || ""; spFile.value = "";
    syncPreview(s.hinhAnh, "spImgPreview");
    document.querySelectorAll(".sp-create-only").forEach(e => e.classList.add("d-none"));
    spModalErr.classList.add("d-none");
    new bootstrap.Modal(document.getElementById("productModal")).show();
}

async function saveProduct() {
    const err = document.getElementById("spModalErr"); err.classList.add("d-none");
    const isEdit = !!spId.value;
    try {
        if (isEdit) {
            await HCShopApi.request("/api/san-pham/" + spId.value, {
                method: "PUT",
                body: JSON.stringify({ danhMucId: parseInt(spDanhMuc.value), maSanPham: spMa.value, ten: spTen.value, giaBan: parseFloat(spGia.value), hinhAnh: spHinhAnh.value || null, moTa: spMoTa.value || "", hienThi: true })
            });
        } else {
            await HCShopApi.request("/api/san-pham", {
                method: "POST",
                body: JSON.stringify({ danhMucId: parseInt(spDanhMuc.value), maSanPham: spMa.value, ten: spTen.value, giaBan: parseFloat(spGia.value), soLuongBanDau: parseInt(spTon.value || "0"), nguongToiThieu: parseInt(spNguong.value || "0"), hinhAnh: spHinhAnh.value || null, moTa: spMoTa.value || "", hienThi: true })
            });
        }
        bootstrap.Modal.getInstance(document.getElementById("productModal")).hide();
        catTab("sp");
    } catch (e) { err.classList.remove("d-none"); err.textContent = e.message; }
}

async function saveCategory() {
    const err = document.getElementById("dmModalErr"); err.classList.add("d-none");
    try {
        await HCShopApi.request("/api/danh-muc", { method: "POST", body: JSON.stringify({ ten: dmTen.value, moTa: dmMoTa.value || null, hinhAnh: dmHinhAnh.value || null, hienThi: true }) });
        bootstrap.Modal.getInstance(document.getElementById("categoryModal")).hide();
        catTab("dm");
    } catch (e) { err.classList.remove("d-none"); err.textContent = e.message; }
}

async function toggleSp(id, st) { await HCShopApi.request("/api/san-pham/" + id + "/an-hien", { method: "PATCH", body: JSON.stringify({ hienThi: st }) }); catTab("sp"); }
async function delSp(id) { if (!confirm("Xóa sản phẩm?")) return; try { await HCShopApi.request("/api/san-pham/" + id, { method: "DELETE" }); catTab("sp"); } catch (e) { alert(e.message); } }
async function toggleDm(id, st) { await HCShopApi.request("/api/danh-muc/" + id + "/an-hien", { method: "PATCH", body: JSON.stringify({ hienThi: st }) }); catTab("dm"); }
async function delDm(id) { if (!confirm("Xóa danh mục?")) return; try { await HCShopApi.request("/api/danh-muc/" + id, { method: "DELETE" }); catTab("dm"); } catch (e) { alert(e.message); } }
document.addEventListener("DOMContentLoaded", () => catTab("sp"));
</script>
}
