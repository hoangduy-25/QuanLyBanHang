@{ ViewBag.Title = "Hồ sơ cá nhân"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Tài khoản của tôi</h4>
    <a href="@Url.Action("Index", "DonHang")" class="btn btn-light border btn-sm hc-pill px-3">Xem đơn hàng của tôi &rarr;</a>
</div>
<div id="acc-alert" class="alert d-none"></div>
<div class="row g-4">
    <div class="col-md-3">
        <div class="hc-card p-2 d-grid gap-1" id="acc-tabs">
            <button class="hc-cat-pill active text-start" onclick="showAccTab('info', this)">Thông tin cá nhân</button>
            <button class="hc-cat-pill text-start" onclick="showAccTab('addr', this)">Sổ địa chỉ nhận hàng</button>
            <button class="hc-cat-pill text-start" onclick="showAccTab('sec', this)">Mật khẩu &amp; Bảo mật</button>
        </div>
    </div>
    <div class="col-md-9">
        <div id="acc-info" class="hc-card p-4">
            <h5 class="fw-bold mb-3">Thông tin cá nhân</h5>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label small fw-semibold">Họ và tên *</label><input id="aHoTen" class="form-control hc-pill" /></div>
                <div class="col-md-6"><label class="form-label small fw-semibold">Số điện thoại *</label><input id="aSdt" class="form-control hc-pill" /></div>
                <div class="col-md-6"><label class="form-label small fw-semibold">Email</label><input id="aEmail" class="form-control hc-pill bg-light" readonly /></div>
                <div class="col-md-3"><label class="form-label small fw-semibold">Ngày sinh</label><input id="aNgaySinh" type="date" class="form-control hc-pill" /></div>
                <div class="col-md-3"><label class="form-label small fw-semibold">Giới tính</label>
                    <select id="aGioiTinh" class="form-select hc-pill"><option value="">--</option><option value="Nam">Nam</option><option value="Nu">Nữ</option><option value="Khac">Khác</option></select>
                </div>
            </div>
            <button class="btn hc-btn-primary btn-sm px-4 mt-3" onclick="saveProf()">Lưu thay đổi hồ sơ</button>
        </div>

        <div id="acc-addr" class="hc-card p-4 d-none">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold mb-0">Sổ địa chỉ nhận hàng</h5>
                <button class="btn hc-btn-primary btn-sm px-3" onclick="addAddr()">+ Thêm địa chỉ</button>
            </div>
            <div id="acc-addr-list"></div>
        </div>

        <div id="acc-sec" class="hc-card p-4 d-none">
            <h5 class="fw-bold mb-3">Đổi mật khẩu (UC-04)</h5>
            <div class="row g-2 mb-4" style="max-width:460px">
                <input id="pwOld" type="password" class="form-control hc-pill" placeholder="Mật khẩu hiện tại" />
                <input id="pwNew" type="password" class="form-control hc-pill" placeholder="Mật khẩu mới" />
                <input id="pwCf" type="password" class="form-control hc-pill" placeholder="Xác nhận mật khẩu mới" />
                <button class="btn hc-btn-primary btn-sm" onclick="changePw()">Đổi mật khẩu</button>
            </div>
            <h5 class="fw-bold mb-3">Câu hỏi bảo mật (UC-05)</h5>
            <div class="row g-2" style="max-width:460px">
                <input id="sqQ" class="form-control hc-pill" placeholder="Câu hỏi bảo mật" />
                <input id="sqA" class="form-control hc-pill" placeholder="Câu trả lời bảo mật" />
                <input id="sqPw" type="password" class="form-control hc-pill" placeholder="Mật khẩu hiện tại để xác nhận" />
                <button class="btn hc-btn-primary btn-sm" onclick="saveSq()">Lưu câu hỏi bảo mật</button>
            </div>
        </div>
    </div>
</div>
@section scripts {
<script>
function showAccTab(name, btn) {
    ["info", "addr", "sec"].forEach(t => document.getElementById("acc-" + t).classList.toggle("d-none", t !== name));
    document.querySelectorAll("#acc-tabs .hc-cat-pill").forEach(b => b.classList.remove("active"));
    btn.classList.add("active");
}
async function loadAcc() {
    const res = await HCShopApi.request("/api/tai-khoan/ho-so");
    if (!res) return;
    aHoTen.value = res.data.hoTen || ""; aSdt.value = res.data.soDienThoai || "";
    aEmail.value = res.data.email || ""; aNgaySinh.value = res.data.ngaySinh ? res.data.ngaySinh.substring(0, 10) : "";
    aGioiTinh.value = res.data.gioiTinh || ""; sqQ.value = res.data.cauHoiBaoMat || "";
    if (res.data.vaiTro === "KhachHang") loadAddrs();
}
async function saveProf() {
    const box = document.getElementById("acc-alert");
    try {
        await HCShopApi.request("/api/tai-khoan/ho-so", { method: "PUT", body: JSON.stringify({ hoTen: aHoTen.value, soDienThoai: aSdt.value, ngaySinh: aNgaySinh.value || null, gioiTinh: aGioiTinh.value || null }) });
        box.className = "alert alert-success"; box.textContent = "Đã lưu thay đổi hồ sơ.";
    } catch (e) { box.className = "alert alert-danger"; box.textContent = e.message; }
}
async function loadAddrs() {
    const res = await HCShopApi.request("/api/dia-chi");
    document.getElementById("acc-addr-list").innerHTML = !res.data.length ? "<p class='text-muted small'>Chưa có địa chỉ.</p>" :
        res.data.map(a => `<div class="border rounded-3 p-3 mb-2 d-flex justify-content-between align-items-center">
            <div><strong>${a.tenNguoiNhan}</strong> (${a.soDienThoai}) ${a.macDinh ? '<span class="badge hc-badge-success">Mặc định</span>' : ''}<div class="small text-muted">${a.diaChiDayDu}</div></div>
            <div class="d-flex gap-2">
                ${!a.macDinh ? `<button class="btn btn-light border btn-sm hc-pill" onclick="defAddr('${a.id}')">Đặt mặc định</button>` : ""}
                <button class="btn btn-light border text-danger btn-sm hc-pill" onclick="rmAddr('${a.id}')">Xóa</button>
            </div>
        </div>`).join("");
}
async function defAddr(id) { await HCShopApi.request("/api/dia-chi/" + id + "/mac-dinh", { method: "PATCH" }); loadAddrs(); }
async function rmAddr(id) { if (!confirm("Xóa địa chỉ?")) return; await HCShopApi.request("/api/dia-chi/" + id, { method: "DELETE" }); loadAddrs(); }
async function addAddr() {
    const ten = prompt("Tên người nhận:"); if (!ten) return;
    await HCShopApi.request("/api/dia-chi", { method: "POST", body: JSON.stringify({ tenNguoiNhan: ten, soDienThoai: prompt("SĐT:"), tinhThanh: prompt("Tỉnh/Thành:"), quanHuyen: prompt("Quận/Huyện:"), phuongXa: prompt("Phường/Xã:"), diaChiCuThe: prompt("Địa chỉ cụ thể:"), macDinh: false }) });
    loadAddrs();
}
async function changePw() {
    const box = document.getElementById("acc-alert");
    try { await HCShopApi.request("/api/xac-thuc/doi-mat-khau", { method: "POST", body: JSON.stringify({ matKhauCu: pwOld.value, matKhauMoi: pwNew.value, xacNhanMatKhauMoi: pwCf.value }) }); box.className = "alert alert-success"; box.textContent = "Đổi mật khẩu thành công."; }
    catch (e) { box.className = "alert alert-danger"; box.textContent = e.message; }
}
async function saveSq() {
    const box = document.getElementById("acc-alert");
    try { await HCShopApi.request("/api/xac-thuc/cap-nhat-cau-hoi-bao-mat", { method: "PUT", body: JSON.stringify({ cauHoiBaoMat: sqQ.value, cauTraLoiBaoMat: sqA.value, matKhauHienTai: sqPw.value }) }); box.className = "alert alert-success"; box.textContent = "Đã cập nhật câu hỏi bảo mật."; }
    catch (e) { box.className = "alert alert-danger"; box.textContent = e.message; }
}
document.addEventListener("DOMContentLoaded", loadAcc);
</script>
}
