<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - HCShop</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700&display=swap" rel="stylesheet" />
    @Styles.Render("~/Content/css")
    <link href="@Url.Content("~/Content/hcshop.css")" rel="stylesheet" />
</head>
<body class="hc-body">
    <header class="hc-navbar no-print">
        <div class="container py-2">
            <div class="d-flex align-items-center justify-content-between gap-3">
                <a class="d-flex align-items-center gap-2 text-decoration-none text-dark" href="@Url.Action("Index", "Home")">
                    <span class="hc-logo-badge">HC</span>
                    <span class="fw-bold fs-5">HCShop</span>
                </a>

                <form class="flex-grow-1 mx-2" style="max-width:460px" action="@Url.Action("Index", "Home")" method="get">
                    <input class="form-control hc-pill bg-light border-0 px-3" type="search" name="TuKhoa" placeholder="Tìm kiếm..." />
                </form>

                <div class="d-flex align-items-center gap-2">
                    <a href="@Url.Action("Index", "GioHang")" class="btn hc-btn-cart btn-sm px-3 d-flex align-items-center gap-2">
                        <span>Giỏ hàng</span>
                        <span id="hc-cart-badge" class="badge rounded-pill bg-primary">0</span>
                    </a>

                    <div class="dropdown">
                        <button class="btn btn-light hc-pill border d-flex align-items-center gap-2 py-1 px-2" type="button" data-bs-toggle="dropdown">
                            <span id="hc-user-avatar" class="hc-logo-badge" style="width:28px;height:28px;font-size:12px">G</span>
                            <div class="text-start d-none d-md-block lh-1">
                                <div id="hc-user-name" class="small fw-semibold">Khách vãng lai</div>
                                <div id="hc-user-email" style="font-size:11px" class="text-muted">Đăng nhập / Đăng ký</div>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border rounded-4 p-2" style="min-width:230px">
                            <li class="dropdown-header small text-uppercase">Tài khoản cá nhân</li>
                            <li id="hc-auth-menu-item"><a class="dropdown-item rounded-3" href="@Url.Action("Index", "XacThuc")">Đăng nhập / Đăng ký</a></li>
                            <li><a class="dropdown-item rounded-3" href="@Url.Action("Index", "TaiKhoan")">Hồ sơ cá nhân &amp; Sổ địa chỉ</a></li>
                            <li><a class="dropdown-item rounded-3" href="@Url.Action("Index", "DonHang")">Đơn hàng của tôi</a></li>
                            <li><a class="dropdown-item rounded-3" href="@Url.Action("YeuThich", "GioHang")">Sản phẩm yêu thích</a></li>
                            <li><a class="dropdown-item rounded-3" href="@Url.Action("Index", "MaGiamGia")">Kho mã giảm giá</a></li>
                            <li id="hc-portal-menu-item" class="d-none">
                                <hr class="dropdown-divider" />
                                <a class="dropdown-item rounded-3 fw-semibold text-primary" href="@Url.Action("Index", "QuanTri")">Mở trang Quản trị (/QuanTri)</a>
                            </li>
                            <li id="hc-logout-menu-item" class="d-none">
                                <hr class="dropdown-divider" />
                                <button class="dropdown-item rounded-3 text-danger" type="button" onclick="HCShopApi.logout()">Đăng xuất</button>
                            </li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <div class="hc-cat-strip">
            <div class="container py-1 d-flex align-items-center gap-2 small">
                <a class="hc-cat-pill" href="@Url.Action("Index", "Home")">Tất cả sản phẩm</a>
                <a class="hc-cat-pill" href="@Url.Action("Index", "MaGiamGia")">Kho mã giảm giá</a>
                <a class="hc-cat-pill" href="@Url.Action("YeuThich", "GioHang")">Yêu thích</a>
                <a class="hc-cat-pill" href="@Url.Action("Index", "DonHang")">Tra cứu đơn hàng</a>
            </div>
        </div>
    </header>

    <main class="container py-4">
        @RenderBody()
    </main>

    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")
    <script src="@Url.Content("~/Scripts/hcshop-api.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
